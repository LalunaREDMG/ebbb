<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EIGHT - Bites, Beats & Burgers</title>
    <link rel="stylesheet" href="styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://apis.google.com/js/api.js"></script>
    <script src="config.js"></script>
    <script src="googleSheets.js"></script>
    <script src="script.js"></script>
  </head>
  <body>
    <nav>
      <div class="logo">EIGHT</div>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <ul class="nav-links">
        <li><a href="#concept">Concept</a></li>
        <li><a href="#menu">Menu</a></li>
        <li><a href="#story">Our Story</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <header class="hero">
      <h1>EIGHT</h1>
      <p class="tagline">Bites, Beats & Burgers</p>
    </header>

    <section id="concept" class="concept">
      <h2>Two Identities, One Place</h2>
      <div class="identity-cards">
        <div class="card morning">
          <h3>Morning Bites</h3>
          <p>Start your day with our artisanal paninis and specialty coffee</p>
          <span class="time">7AM - 3PM</span>
        </div>
        <div class="card night">
          <h3>Night Burgers</h3>
          <p>Experience our signature smashed burgers</p>
          <span class="time">5PM - 11PM</span>
        </div>
        <div class="card weekend">
          <h3>Weekend Beats</h3>
          <p>Enjoy live music from local DJs</p>
          <span class="time">Friday & Saturday Nights</span>
        </div>
      </div>
    </section>

    <section id="menu" class="menu">
      <h2>Our Menu</h2>
      <div class="menu-tabs">
        <button class="tab-btn active" data-tab="bites">Bites</button>
        <button class="tab-btn" data-tab="burgers">Burgers</button>
        <button class="tab-btn" data-tab="drinks">Drinks</button>
      </div>
      <div class="menu-content">
        <!-- Menu content will be populated via JavaScript -->
      </div>
    </section>

    <section id="story" class="story">
      <h2>Our Story</h2>
      <p>
        Born from the idea of creating a versatile space that transforms with
        the day, EIGHT brings together the best of both worlds. From morning
        coffee enthusiasts to night-time burger lovers, we've created a space
        where everyone belongs.
      </p>
    </section>

    <section id="announcements" class="announcements">
      <h2>What's Happening</h2>
      <div class="announcement-slider">
        <div class="announcement">
          <h3>DJ of the Week</h3>
          <p>Catch DJ Lorem this Saturday night!</p>
        </div>
        <!-- More announcements can be added here -->
      </div>
    </section>

    <section id="contact" class="contact">
      <h2>Get in Touch</h2>
      <div class="contact-info">
        <div class="info-item">
          <h3>Location</h3>
          <p>123 Food Street, Metro Manila</p>
        </div>
        <div class="info-item">
          <h3>Contact</h3>
          <p>Phone: (02) 8123-4567</p>
          <p>Email: hello@eightmnl.com</p>
        </div>
        <div class="info-item">
          <h3>Hours</h3>
          <p>Monday - Sunday: 7AM - 11PM</p>
          <p>Weekend Events: 8PM onwards</p>
        </div>
      </div>
    </section>

    <footer>
      <p>&copy; 2024 EIGHT - Bites, Beats & Burgers. All rights reserved.</p>
    </footer>
  </body>
</html>
